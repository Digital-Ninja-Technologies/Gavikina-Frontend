{
  "name": "gavikina-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/website",
    "apps/dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev -w apps/website",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "build": "npm run build -w apps/website -w apps/dashboard",
    "build:website": "npm run build -w apps/website",
    "build:dashboard": "npm run build -w apps/dashboard",
    "lint": "npm run lint -w apps/website -w apps/dashboard"
  }
}
